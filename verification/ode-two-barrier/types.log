def ExactLiouvilleComparison.ODE.TwoBarrierEvolutionTarget : {d : ℕ} → {M : FsFltz.Geometry.SmoothManifold d} → Prop :=
fun {d} {M} =>
  ∀ (Z : ℝ → (x : M.Point) → M.Tangent x) (Ω : Set (ℝ × M.Point)),
    IsOpen Ω →
      FsFltz.Geometry.parameterInterval ×ˢ Set.univ ⊆ Ω →
        ContMDiffOn ((modelWithCornersSelf ℝ ℝ).prod (modelWithCornersSelf ℝ (FsFltz.Geometry.Model d)))
            (modelWithCornersSelf ℝ (FsFltz.Geometry.Model d)).tangent (↑⊤) (fun p => ⟨p.2, Z p.1 p.2⟩) Ω →
          ∀ (R : M.Point → ℝ),
            ContMDiff (modelWithCornersSelf ℝ (FsFltz.Geometry.Model d)) (modelWithCornersSelf ℝ ℝ) (↑⊤) R →
              IsProperMap R →
                BddBelow (Set.range R) →
                  ∀ (Q : ℝ → M.Point → ℝ),
                    (ContMDiff ((modelWithCornersSelf ℝ ℝ).prod (modelWithCornersSelf ℝ (FsFltz.Geometry.Model d)))
                        (modelWithCornersSelf ℝ ℝ) ↑⊤ fun p => Q p.1 p.2) →
                      (∀ (L : ℝ), ∃ A, ∀ t ∈ FsFltz.Geometry.parameterInterval, ∀ (x : M.Point), Q t x ≤ L → R x ≤ A) →
                        ∀ (C₀ C₁ : ℝ),
                          0 ≤ C₀ →
                            0 ≤ C₁ →
                              (∀ t ∈ FsFltz.Geometry.parameterInterval,
                                  ∀ (x : M.Point), M.scalarDerivative R x (Z t x) ≤ C₀) →
                                (∀ t ∈ FsFltz.Geometry.parameterInterval,
                                    ∀ (x : M.Point), 0 ≤ deriv (fun u => Q u x) t) →
                                  (∀ t ∈ FsFltz.Geometry.parameterInterval,
                                      ∀ (x : M.Point),
                                        -C₁ ≤ deriv (fun u => Q u x) t + M.scalarDerivative (Q t) x (Z t x)) →
                                    Nonempty (ExactLiouvilleComparison.FirstPathFlow.Evolution fun t => Z ↑t)
structure ExactLiouvilleComparison.FirstPathFlow.Evolution {d : ℕ} {M : FsFltz.Geometry.SmoothManifold d}
  (Z : ↑FsFltz.Geometry.Parameter → (x : M.Point) → M.Tangent x) : Type
