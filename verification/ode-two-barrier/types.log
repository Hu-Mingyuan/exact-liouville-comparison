fields:
  ExactLiouvilleComparison.FirstPathFlow.Evolution.map : ↑FsFltz.Geometry.Parameter →
      ↑FsFltz.Geometry.Parameter → M.SmoothEquiv M
  ExactLiouvilleComparison.FirstPathFlow.Evolution.extension : ℝ → ℝ → M.Point → M.Point
  ExactLiouvilleComparison.FirstPathFlow.Evolution.agrees : ∀ (s t : ↑FsFltz.Geometry.Parameter),
      self.extension ↑s ↑t = ⇑(self.map s t)
  ExactLiouvilleComparison.FirstPathFlow.Evolution.smooth : ∃ U,
      IsOpen U ∧
        FsFltz.Geometry.parameterInterval ×ˢ FsFltz.Geometry.parameterInterval ×ˢ Set.univ ⊆ U ∧
          ContMDiffOn
            ((modelWithCornersSelf ℝ ℝ).prod
              ((modelWithCornersSelf ℝ ℝ).prod (modelWithCornersSelf ℝ (FsFltz.Geometry.Model d))))
            (modelWithCornersSelf ℝ (FsFltz.Geometry.Model d)) (↑⊤) (fun p => self.extension p.1 p.2.1 p.2.2) U
  ExactLiouvilleComparison.FirstPathFlow.Evolution.initial : ∀ (s : ↑FsFltz.Geometry.Parameter) (x : M.Point),
      (self.map s s) x = x
  ExactLiouvilleComparison.FirstPathFlow.Evolution.solves : ∀ (s : ↑FsFltz.Geometry.Parameter) (x : M.Point),
      ExactLiouvilleComparison.FirstPathFlow.IsSolution Z (fun t => self.extension (↑s) t x)
        FsFltz.Geometry.parameterInterval
  ExactLiouvilleComparison.FirstPathFlow.Evolution.chart_solves : ∀ (s t : ↑FsFltz.Geometry.Parameter) (x a : M.Point),
      (self.map s t) x ∈ (chartAt (FsFltz.Geometry.Model d) a).source →
        HasDerivWithinAt (fun u => ↑(chartAt (FsFltz.Geometry.Model d) a) (self.extension (↑s) u x))
          ((M.chartTangentMap a ((self.map s t) x)) (Z t ((self.map s t) x))) FsFltz.Geometry.parameterInterval ↑t
  ExactLiouvilleComparison.FirstPathFlow.Evolution.unique : ∀ (s t : ↑FsFltz.Geometry.Parameter) (γ : ℝ → M.Point),
      ExactLiouvilleComparison.FirstPathFlow.IsSolution Z γ (Set.uIcc ↑s ↑t) → γ ↑t = (self.map s t) (γ ↑s)
