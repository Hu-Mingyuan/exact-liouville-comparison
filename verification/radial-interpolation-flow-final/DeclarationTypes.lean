run_cmd do
  for n in [``ExactLiouvilleComparison.RadialInterpolationFlow.Target, ``ExactLiouvilleComparison.ODE.TwoBarrierEvolutionTarget, ``ExactLiouvilleComparison.RadialInterpolationFlow.field_eq, ``ExactLiouvilleComparison.RadialInterpolationFlow.barrier_smooth, ``ExactLiouvilleComparison.RadialInterpolationFlow.barrier_time_derivative, ``ExactLiouvilleComparison.RadialInterpolationFlow.barrier_time_nonneg, ``ExactLiouvilleComparison.RadialInterpolationFlow.barrier_sublevel, ``ExactLiouvilleComparison.RadialInterpolationFlow.of_twoBarrier, ``ExactLiouvilleComparison.RadialInterpolationFlow.oneCoefficient, ``ExactLiouvilleComparison.RadialInterpolationFlow.largeCoefficient, ``ExactLiouvilleComparison.RadialInterpolationFlow.largeCoefficient_prime, ``ExactLiouvilleComparison.RadialInterpolationFlow.second_applicable, ``ExactLiouvilleComparison.RadialInterpolationFlow.fourth_applicable, ``ExactLiouvilleComparison.RadialInterpolationFlow.second_rho, ``ExactLiouvilleComparison.RadialInterpolationFlow.fourth_rho, ``ExactLiouvilleComparison.RadialInterpolationFlow.equal_evolution, ``ExactLiouvilleComparison.RadialInterpolationFlow.critical_field_zero, ``ExactLiouvilleComparison.ODE.twoBarrier_forward_cutoff, ``ExactLiouvilleComparison.ODE.twoBarrier_reverse_cutoff, ``ExactLiouvilleComparison.ODE.twoBarrier_hasDerivAt, ``ExactLiouvilleComparison.ODE.twoBarrier_forward_displacement, ``ExactLiouvilleComparison.ODE.twoBarrier_reverse_displacement, ``ExactLiouvilleComparison.ODE.twoBarrier_spatial_hasDerivAt, ``ExactLiouvilleComparison.ODE.twoBarrier_compact_confinement, ``ExactLiouvilleComparison.ODE.twoBarrier_finiteIntervalExistence, ``ExactLiouvilleComparison.ODE.smoothEvolution_of_compact_support, ``ExactLiouvilleComparison.ODE.compact_field_localization, ``ExactLiouvilleComparison.ODE.eqOn_closed_of_hasMFDerivWithinAt, ``ExactLiouvilleComparison.ODE.EvolutionPatch, ``ExactLiouvilleComparison.ODE.enlarged_interval, ``ExactLiouvilleComparison.ODE.evolutionPatch_of_finite_curve, ``ExactLiouvilleComparison.ODE.EvolutionPatch.domain, ``ExactLiouvilleComparison.ODE.EvolutionPatch.open_domain, ``ExactLiouvilleComparison.ODE.EvolutionPatch.agree, ``ExactLiouvilleComparison.ODE.evolutionDomain, ``ExactLiouvilleComparison.ODE.localEvolution, ``ExactLiouvilleComparison.ODE.localEvolution_eq_patch, ``ExactLiouvilleComparison.ODE.isOpen_evolutionDomain, ``ExactLiouvilleComparison.ODE.localEvolution_contMDiffAt, ``ExactLiouvilleComparison.ODE.localEvolution_initial, ``ExactLiouvilleComparison.ODE.localEvolution_solves, ``ExactLiouvilleComparison.ODE.strip_subset_evolutionDomain, ``ExactLiouvilleComparison.ODE.evolution_of_finite_existence_global, ``ExactLiouvilleComparison.ODE.evolution_of_finite_existence, ``ExactLiouvilleComparison.ODE.twoBarrierEvolution, ``ExactLiouvilleComparison.RadialInterpolationFlow.radialInterpolationFlow, ``ExactLiouvilleComparison.RadialInterpolationFlow.evolution, ``ExactLiouvilleComparison.RadialInterpolationFlow.native_ode, ``ExactLiouvilleComparison.RadialInterpolationFlow.sigma_zero, ``ExactLiouvilleComparison.RadialInterpolationFlow.unit_start, ``ExactLiouvilleComparison.RadialInterpolationFlow.second_path, ``ExactLiouvilleComparison.RadialInterpolationFlow.fourth_path, ``ExactLiouvilleComparison.RadialInterpolationFlow.fixes_of_zero, ``ExactLiouvilleComparison.RadialInterpolationFlow.equal_identity, ``ExactLiouvilleComparison.RadialInterpolationFlow.critical_fixed, ``ExactLiouvilleComparison.RadialInterpolationFlow.endpoint_inverse_isotopy] do
    let info ← getConstInfo n
    let ty ← liftTermElabM do PrettyPrinter.ppExpr info.type
    let line := s!"{n} : {ty.pretty}"
    logInfo m!"RADIAL_TYPE_ASCII {line.toList.map Char.toNat}"
  for n in [``ExactLiouvilleComparison.RadialInterpolationFlow.Target, ``ExactLiouvilleComparison.ODE.TwoBarrierEvolutionTarget, ``ExactLiouvilleComparison.FirstPathFlow.Evolution, ``ExactLiouvilleComparison.ODE.EvolutionPatch] do
    let info ← getConstInfo n
    if let .defnInfo v := info then
      let val ← liftTermElabM do PrettyPrinter.ppExpr v.value
      let line := s!"definition {n} := {val.pretty}"
      logInfo m!"RADIAL_TYPE_ASCII {line.toList.map Char.toNat}"
    if let some st := getStructureInfo? (← getEnv) n then
      for field in st.fieldNames do
        if let some proj := getProjFnForField? (← getEnv) n field then
          let pinfo ← getConstInfo proj
          let ty ← liftTermElabM do PrettyPrinter.ppExpr pinfo.type
          let line := s!"{proj} : {ty.pretty}"
          logInfo m!"RADIAL_TYPE_ASCII {line.toList.map Char.toNat}"
#eval IO.println "RADIAL_FLOW_FINAL_DECLARATIONTYPES_COMPLETE"
