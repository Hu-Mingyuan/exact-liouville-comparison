theorem ExactLiouvilleComparison.LargeCoefficientChecks.arbitrary_primitive : ∀ {d : ℕ} (M : SmoothManifold d)
  (P : RadialReference M) (lam : M.Form 1),
  M.IsSmoothForm lam →
    ∃ rho,
      ContDiff ℝ ∞ rho ∧
        Monotone rho ∧
          (∀ r ∈ Icc 1 P.rstar, rho r = rho 1) ∧
            (∀ (r : ℝ), 0 ≤ deriv rho r) ∧
              (∀ (r : ℝ), 1 ≤ rho r) ∧
                (∀ (r : ℝ), 1 ≤ r → 0 < rho r + r * deriv rho r) ∧
                  ∀ (x : M.Point), 1 + P.compatible.dualNorm x (LargeCoefficient.oneCovector lam x) ≤ rho (P.R x) :=
fun {d} M P lam hlam =>
  And.casesOn (LargeCoefficient.coefficient_properties P lam hlam) fun hs right =>
    And.casesOn right fun hm right =>
      And.casesOn right fun hc right =>
        And.casesOn right fun hd right =>
          And.casesOn right fun h1 right =>
            And.casesOn right fun hp hdom =>
              Exists.intro (LargeCoefficient.A P lam)
                ⟨hs,
                  ⟨hm,
                    ⟨fun r hr =>
                      Eq.mpr (id (congrArg (fun _a => _a = LargeCoefficient.A P lam 1) (hc r hr)))
                        (Eq.mpr
                          (id
                            (congrArg (fun _a => LargeCoefficient.levels P lam 0 = _a)
                              (LargeCoefficient.A_core P lam (LT.lt.le P.one_lt_rstar))))
                          (Eq.refl (LargeCoefficient.levels P lam 0))),
                      ⟨hd, ⟨h1, ⟨hp, hdom⟩⟩⟩⟩⟩⟩
theorem ExactLiouvilleComparison.LargeCoefficientChecks.interpolation_endpoints : ∀ {d : ℕ} (M : SmoothManifold d)
  (P : RadialReference M) (T : ExactSymplecticStructure M) (G : AdmissibleGrowth 1),
  ∀ r ∈ Ici 1,
    SmallCoefficient.k G P.rstar r ≤ LargeCoefficient.A P T.primitive r ∧
      0 < LargeCoefficient.A P T.primitive r + r * deriv (LargeCoefficient.A P T.primitive) r :=
fun {d} M P T G r hr =>
  ⟨LargeCoefficient.k_le_A P T.primitive T.smooth_primitive G hr,
    LargeCoefficient.A_radial_pos P T.primitive T.smooth_primitive hr⟩
theorem ExactLiouvilleComparison.LargeCoefficientChecks.empty_manifold_levels : ∀ {d : ℕ} (M : SmoothManifold d)
  [IsEmpty M.Point] (P : RadialReference M) (lam : M.Form 1) (n : ℕ), LargeCoefficient.levels P lam n = 1 :=
fun {d} M [IsEmpty M.Point] P lam n =>
  LargeCoefficient.levels_empty P lam n (eq_empty_of_isEmpty (LargeCoefficient.sublevel P n))
