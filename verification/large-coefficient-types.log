theorem ExactLiouvilleComparison.LargeCoefficient.coefficient_properties : ∀ {d : ℕ}
  {M : FsFltz.Geometry.SmoothManifold d} (P : ExactLiouvilleComparison.RadialReference M) (lam : M.Form 1),
  M.IsSmoothForm lam →
