          (∀ (r : ℝ), 0 ≤ deriv (ExactLiouvilleComparison.LargeCoefficient.A P lam) r) ∧
            (∀ (r : ℝ), 1 ≤ ExactLiouvilleComparison.LargeCoefficient.A P lam r) ∧
