                        r * deriv (ExactLiouvilleComparison.LargeCoefficient.A P lam) r) ∧
                ∀ (x : M.Point),
                  1 + P.compatible.dualNorm x (ExactLiouvilleComparison.LargeCoefficient.oneCovector lam x) ≤
                    ExactLiouvilleComparison.LargeCoefficient.A P lam (P.R x) :=
