      FsFltz.Geometry.IntrinsicLiouville.Nondegenerate (FsFltz.Geometry.IntrinsicLiouville.exteriorDerivative α) x)
  (hout : FiniteTypePresentation.LocalOutward α) : NativeIntegration.PrescribedExtension α hα hnd hout
