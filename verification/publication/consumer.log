ExactLiouvilleComparison.CylindricalCompatibility.extension_of_prescribed_kernel {d : ℕ}
  {D : FsFltz.Geometry.LiouvilleDomain d} (C : FsFltz.Geometry.Completion D)
  (j :
    (y : D.domain.boundary.Point) →
      ↥(CylindricalCompatibility.ContactFiber D y) →L[ℝ] ↥(CylindricalCompatibility.ContactFiber D y))
  (hj :
    CylindricalCompatibility.ContactBundle.SmoothKernelEndomorphism D
      (CylindricalCompatibility.ContactBundle.Atlas.prebundle D) j)
  (hsquare : ∀ (y : D.domain.boundary.Point) (v : ↥(CylindricalCompatibility.ContactFiber D y)), (j y) ((j y) v) = -v)
  (hinvariant :
    ∀ (y : D.domain.boundary.Point) (v w : ↥(CylindricalCompatibility.ContactFiber D y)),
      (D.domain.boundary.contactHyperplaneDifferential (CylindricalCompatibility.alpha D) y) ![(j y) v, (j y) w] =
        (D.domain.boundary.contactHyperplaneDifferential (CylindricalCompatibility.alpha D) y) ![v, w])
  (hpositive :
    ∀ (y : D.domain.boundary.Point) (v : ↥(D.domain.boundary.contactHyperplane (CylindricalCompatibility.alpha D) y)),
      v ≠ 0 →
        0 < (D.domain.boundary.contactHyperplaneDifferential (CylindricalCompatibility.alpha D) y) ![v, (j y) v]) :
  ∃ A,
    Nonempty (CylindricalStructure C A) ∧
      ∀ (y : D.domain.boundary.Point) (t : ℝ),
        0 ≤ t →
          ∀ (v : D.domain.boundary.Tangent y) (s : ℝ),
            (A.J (C.endMap (y, t))) ((mfderiv% C.endMap (y, t)) (v, s)) =
              (mfderiv% C.endMap (y, t))
                (↑((j y) ((CylindricalCompatibility.boundaryKernelProjection D y) v)) +
                    s • CylindricalCompatibility.boundaryReeb D y,
                  -FsFltz.Geometry.SmoothManifold.evalOne (CylindricalCompatibility.alpha D) y v)
ExactLiouvilleComparison.NativeIntegration.constructedComparison {k : ℕ} {M : Type} [TopologicalSpace M] [T2Space M]
  [SecondCountableTopology M] [CompactSpace M] [ChartedSpace (EuclideanHalfSpace (k + 1)) M]
  [IsManifold (modelWithCornersEuclideanHalfSpace (k + 1)) (↑⊤) M] (α : FsFltz.Geometry.IntrinsicLiouville.Form k M 1)
  (hα : FsFltz.Geometry.IntrinsicLiouville.IsLocallyExtendibleForm α)
  (hnd :
    ∀ (x : M),
      FsFltz.Geometry.IntrinsicLiouville.Nondegenerate (FsFltz.Geometry.IntrinsicLiouville.exteriorDerivative α) x)
  (hout : FiniteTypePresentation.LocalOutward α) : NativeIntegration.ConstructedComparison α hα hnd hout
ExactLiouvilleComparison.NativeIntegration.prescribedExtension {k : ℕ} {M : Type} [TopologicalSpace M] [T2Space M]
  [SecondCountableTopology M] [CompactSpace M] [ChartedSpace (EuclideanHalfSpace (k + 1)) M]
  [IsManifold (modelWithCornersEuclideanHalfSpace (k + 1)) (↑⊤) M] (α : FsFltz.Geometry.IntrinsicLiouville.Form k M 1)
