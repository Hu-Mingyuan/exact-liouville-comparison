  (P : ExactLiouvilleComparison.RadialReference M) (q₀ q₁ : ExactLiouvilleComparison.RadialCoefficient P.rstar)
  (horder : ∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ici.{0} 1) r → LE.le.{0} (q₀.rho r) (q₁.rho r)) (σ : M.Form 1)
  (hσ : M.IsSmoothForm σ) (hw : ExactLiouvilleComparison.RadialInterpolation.WeakDifferential σ) :
  (ExactLiouvilleComparison.MoserRegularity.NativeJoint fun t x =>
      ExactLiouvilleComparison.RadialInterpolation.vector
        (ExactLiouvilleComparison.RadialInterpolation.coefficient q₀ q₁ (↑t) (Subtype.property.{1} t)) σ hσ hw
        (fun r => HSub.hSub.{0, 0, 0} (q₁.rho r) (q₀.rho r)) x) ∧
    ∃ C₀ C₁,
      LE.le.{0} 0 C₀ ∧
        LE.le.{0} 0 C₁ ∧
          ∀ (t : ↑FsFltz.Geometry.Parameter) (x : M.Point),
            LE.le.{0}
                (M.scalarDerivative P.R x
                  (ExactLiouvilleComparison.RadialInterpolation.vector
                    (ExactLiouvilleComparison.RadialInterpolation.coefficient q₀ q₁ (↑t) (Subtype.property.{1} t)) σ hσ
                    hw (fun r => HSub.hSub.{0, 0, 0} (q₁.rho r) (q₀.rho r)) x))
                C₀ ∧
              LE.le.{0} (Neg.neg.{0} C₁)
                (ExactLiouvilleComparison.MoserRegularity.barrierRate P q₀ q₁
                  (ExactLiouvilleComparison.MoserRegularity.interpolationField P q₀ q₁ σ hσ hw) t x)
