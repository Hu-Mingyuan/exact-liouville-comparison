  (hw : ExactLiouvilleComparison.RadialInterpolation.WeakDifferential σ) (t : ↑FsFltz.Geometry.Parameter)
  (x : M.Point) :
  Eq.{1}
    (ExactLiouvilleComparison.MoserRegularity.solve
      (ExactLiouvilleComparison.MoserRegularity.interpolationForm P q₀ q₁ σ ↑t)
      (HSub.hSub.{0, 0, 0} q₀.primitive q₁.primitive) x)
    (ExactLiouvilleComparison.RadialInterpolation.vector
      (ExactLiouvilleComparison.RadialInterpolation.coefficient q₀ q₁ (↑t) (Subtype.property.{1} t)) σ hσ hw
      (ExactLiouvilleComparison.RadialInterpolation.delta q₀ q₁) x)
ExactLiouvilleComparison.MoserRegularityChecks.first_actual {d : ℕ} {M : FsFltz.Geometry.SmoothManifold d}
  (P : ExactLiouvilleComparison.RadialReference M) (G : ExactLiouvilleComparison.AdmissibleGrowth 1)
  (T : ExactLiouvilleComparison.ExactSymplecticStructure M) (hw : ExactLiouvilleComparison.WeaklyTames P.compatible T)
  {C : ℝ} (hC : LT.lt.{0} 0 C) (K : Set.{0} M.Point) (hK : IsCompact.{0} K)
  (hb : ∀ x ∉ K, LE.le.{0} (P.compatible.inverseNorm T x) (HMul.hMul.{0, 0, 0} C (G.B (P.R x)))) :
  (ExactLiouvilleComparison.MoserRegularity.NativeJoint fun t x =>
      ExactLiouvilleComparison.FirstPath.X P G T hw x (↑t) (Subtype.property.{1} t).left) ∧
    (M.IsSmoothIntervalVectorFieldFamily fun t x =>
        ExactLiouvilleComparison.FirstPath.X P G T hw x (↑t) (Subtype.property.{1} t).left) ∧
      ∃ D,
        LE.le.{0} 0 D ∧
          ∀ (t : ↑FsFltz.Geometry.Parameter) (x : M.Point),
            LE.le.{0}
              (abs.{0}
                (M.scalarDerivative (fun y => Real.log (ExactLiouvilleComparison.SmallCoefficient.S G (P.R y))) x
                  (ExactLiouvilleComparison.FirstPath.X P G T hw x (↑t) (Subtype.property.{1} t).left)))
              D
