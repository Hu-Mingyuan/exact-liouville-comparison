  Eq.{1}
    (ExactLiouvilleComparison.MoserRegularity.solve (ExactLiouvilleComparison.FirstPath.form P G T t)
      (HSMul.hSMul.{0, 0, 0} (-1) (ExactLiouvilleComparison.FirstPath.coefficient P G).primitive) x)
    (ExactLiouvilleComparison.FirstPath.X P G T hw x t ht)
ExactLiouvilleComparison.MoserRegularityChecks.inverse_is_existing_interpolation {d : ℕ}
  {M : FsFltz.Geometry.SmoothManifold d} (P : ExactLiouvilleComparison.RadialReference M)
