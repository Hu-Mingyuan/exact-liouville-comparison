        (HMul.hMul.{0, 0, 0} r
          (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} (HSub.hSub.{0, 0, 0} 1 u) (q₀.rhoPrime r))
            (HMul.hMul.{0, 0, 0} u (q₁.rhoPrime r)))))
