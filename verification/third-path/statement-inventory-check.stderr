        (FsFltz.Geometry.SmoothManifold.evalTwo (M.exteriorDerivative reference.primitive) x v ((self.J x) w))
constructor:
  ExactLiouvilleComparison.CompatibleStructure.mk {d : ℕ} {M : FsFltz.Geometry.SmoothManifold d}
    {reference : ExactLiouvilleComparison.ExactSymplecticStructure M}
    (J : (x : M.Point) → ContinuousLinearMap.{0, 0, 0, 0} (RingHom.id.{0} ℝ) (M.Tangent x) (M.Tangent x))
    (smooth_J : ExactLiouvilleComparison.SmoothEndomorphism M J)
    (square : ∀ (x : M.Point) (v : M.Tangent x), Eq.{1} ((J x) ((J x) v)) (Neg.neg.{0} v))
    (invariant :
      ∀ (x : M.Point) (v w : M.Tangent x),
        Eq.{1} (FsFltz.Geometry.SmoothManifold.evalTwo (M.exteriorDerivative reference.primitive) x ((J x) v) ((J x) w))
          (FsFltz.Geometry.SmoothManifold.evalTwo (M.exteriorDerivative reference.primitive) x v w))
    (g :
      Bundle.ContMDiffRiemannianMetric.{0, 0, 0, 0, 0} (modelWithCornersSelf.{0, 0} ℝ (FsFltz.Geometry.Model d))
        (↑Top.top.{0}) (FsFltz.Geometry.Model d) M.Tangent)
    (metric_eq :
      ∀ (x : M.Point) (v w : M.Tangent x),
        Eq.{1} (((Bundle.ContMDiffRiemannianMetric.inner.{0, 0, 0, 0, 0} g x) v) w)
          (FsFltz.Geometry.SmoothManifold.evalTwo (M.exteriorDerivative reference.primitive) x v ((J x) w))) :
    ExactLiouvilleComparison.CompatibleStructure reference
def ExactLiouvilleComparison.WeaklyTames : {d : ℕ} →
  {M : FsFltz.Geometry.SmoothManifold d} →
    {S : ExactLiouvilleComparison.ExactSymplecticStructure M} →
      ExactLiouvilleComparison.CompatibleStructure S → ExactLiouvilleComparison.ExactSymplecticStructure M → Prop :=
fun {d} {M} {S} A T =>
  ∀ (x : M.Point) (v : M.Tangent x),
    LE.le.{0} 0 (FsFltz.Geometry.SmoothManifold.evalTwo (M.exteriorDerivative T.primitive) x v ((A.J x) v))
