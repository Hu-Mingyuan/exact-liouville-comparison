def ExactLiouvilleComparison.ThirdPath.Target : {d : ℕ} → {M : FsFltz.Geometry.SmoothManifold d} → Prop :=
fun {d} {M} =>
  ∀ (P : ExactLiouvilleComparison.RadialReference M) (T : ExactLiouvilleComparison.ExactSymplecticStructure M),
    ExactLiouvilleComparison.WeaklyTames P.compatible T →
      Nonempty.{1} (ExactLiouvilleComparison.ThirdPath.Construction P T)
