def ExactLiouvilleComparison.MoserRegularity.NativeJoint : {d : ℕ} →
  {M : FsFltz.Geometry.SmoothManifold d} → (↑FsFltz.Geometry.Parameter → (x : M.Point) → M.Tangent x) → Prop :=
fun {d} {M} Z =>
  ∃ E,
    (∀ (t : ↑FsFltz.Geometry.Parameter), Eq.{1} (E ↑t) (Z t)) ∧
      ∀ (p : Prod.{0, 0} ℝ M.Point),
        Membership.mem.{0, 0} FsFltz.Geometry.parameterInterval p.1 →
          ContMDiffAt.{0, 0, 0, 0, 0, 0, 0}
            (ModelWithCorners.prod.{0, 0, 0, 0, 0} (modelWithCornersSelf.{0, 0} ℝ ℝ)
              (modelWithCornersSelf.{0, 0} ℝ (FsFltz.Geometry.Model d)))
            (ModelWithCorners.tangent.{0, 0, 0} (modelWithCornersSelf.{0, 0} ℝ (FsFltz.Geometry.Model d)))
            (↑Top.top.{0}) (fun q => ⟨q.2, E q.1 q.2⟩) p
structure ExactLiouvilleComparison.RadialReference {d : ℕ} (M : FsFltz.Geometry.SmoothManifold d) : Type
number of parameters: 2
fields:
  ExactLiouvilleComparison.RadialReference.exactStructure : ExactLiouvilleComparison.ExactSymplecticStructure M
  ExactLiouvilleComparison.RadialReference.compatible : ExactLiouvilleComparison.CompatibleStructure self.exactStructure
  ExactLiouvilleComparison.RadialReference.R : M.Point → ℝ
  ExactLiouvilleComparison.RadialReference.smooth_R : ContMDiff.{0, 0, 0, 0, 0, 0, 0}
      (modelWithCornersSelf.{0, 0} ℝ (FsFltz.Geometry.Model d)) (modelWithCornersSelf.{0, 0} ℝ ℝ) (↑Top.top.{0}) self.R
  ExactLiouvilleComparison.RadialReference.proper_R : IsProperMap.{0, 0} self.R
  ExactLiouvilleComparison.RadialReference.lower_R : ∀ (x : M.Point), LE.le.{0} 1 (self.R x)
  ExactLiouvilleComparison.RadialReference.c : ℝ
  ExactLiouvilleComparison.RadialReference.positive_c : LT.lt.{0} 0 self.c
  ExactLiouvilleComparison.RadialReference.rstar : ℝ
  ExactLiouvilleComparison.RadialReference.one_lt_rstar : LT.lt.{0} 1 self.rstar
  ExactLiouvilleComparison.RadialReference.radial_identity : ∀ (x : M.Point),
      LT.lt.{0} self.rstar (self.R x) →
        ∀ (v : M.Tangent x),
          Eq.{1} (FsFltz.Geometry.SmoothManifold.evalOne self.exactStructure.primitive x v)
            (HMul.hMul.{0, 0, 0} (Neg.neg.{0} self.c) (M.scalarDerivative self.R x ((self.compatible.J x) v)))
  ExactLiouvilleComparison.RadialReference.radial_bound : ∀ (x : M.Point),
      LT.lt.{0} self.rstar (self.R x) →
        LE.le.{0} (HMul.hMul.{0, 0, 0} self.c (HPow.hPow.{0, 0, 0} (self.compatible.dualNorm x (mfderiv% self.R x)) 2))
          (self.R x)
constructor:
  ExactLiouvilleComparison.RadialReference.mk {d : ℕ} {M : FsFltz.Geometry.SmoothManifold d}
    (exactStructure : ExactLiouvilleComparison.ExactSymplecticStructure M)
    (compatible : ExactLiouvilleComparison.CompatibleStructure exactStructure) (R : M.Point → ℝ)
    (smooth_R :
      ContMDiff.{0, 0, 0, 0, 0, 0, 0} (modelWithCornersSelf.{0, 0} ℝ (FsFltz.Geometry.Model d))
        (modelWithCornersSelf.{0, 0} ℝ ℝ) (↑Top.top.{0}) R)
    (proper_R : IsProperMap.{0, 0} R) (lower_R : ∀ (x : M.Point), LE.le.{0} 1 (R x)) (c : ℝ)
    (positive_c : LT.lt.{0} 0 c) (rstar : ℝ) (one_lt_rstar : LT.lt.{0} 1 rstar)
    (radial_identity :
      ∀ (x : M.Point),
        LT.lt.{0} rstar (R x) →
          ∀ (v : M.Tangent x),
            Eq.{1} (FsFltz.Geometry.SmoothManifold.evalOne exactStructure.primitive x v)
              (HMul.hMul.{0, 0, 0} (Neg.neg.{0} c) (M.scalarDerivative R x ((compatible.J x) v))))
    (radial_bound :
      ∀ (x : M.Point),
        LT.lt.{0} rstar (R x) →
          LE.le.{0} (HMul.hMul.{0, 0, 0} c (HPow.hPow.{0, 0, 0} (compatible.dualNorm x (mfderiv% R x)) 2)) (R x)) :
    ExactLiouvilleComparison.RadialReference M
structure ExactLiouvilleComparison.CompatibleStructure {d : ℕ} {M : FsFltz.Geometry.SmoothManifold d}
  (reference : ExactLiouvilleComparison.ExactSymplecticStructure M) : Type
number of parameters: 3
fields:
  ExactLiouvilleComparison.CompatibleStructure.J : (x : M.Point) →
