def ExactLiouvilleComparison.ThirdPath.primitive : {d : ℕ} →
  {M : FsFltz.Geometry.SmoothManifold d} →
    ExactLiouvilleComparison.RadialReference M → ExactLiouvilleComparison.ExactSymplecticStructure M → ℝ → M.Form 1 :=
fun {d} {M} P T s =>
  HAdd.hAdd.{0, 0, 0}
    (ExactLiouvilleComparison.LinearAlgebraChecks.radialPrimitive P
      (ExactLiouvilleComparison.LargeCoefficient.A P T.primitive))
    (HSMul.hSMul.{0, 0, 0} s T.primitive)
def ExactLiouvilleComparison.ThirdPath.exhaustion : {d : ℕ} →
  {M : FsFltz.Geometry.SmoothManifold d} → ExactLiouvilleComparison.RadialReference M → M.Point → ℝ :=
fun {d} {M} P x => √(P.R x)
