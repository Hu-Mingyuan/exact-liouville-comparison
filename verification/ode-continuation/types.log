def ExactLiouvilleComparison.ODE.FiniteIntervalExistenceTarget : {d : ℕ} →
  {M : FsFltz.Geometry.SmoothManifold d} → Prop :=
fun {d} {M} =>
  ∀ (Z : ℝ → (x : M.Point) → M.Tangent x) (Ω : Set (ℝ × M.Point)),
    IsOpen Ω →
      FsFltz.Geometry.parameterInterval ×ˢ Set.univ ⊆ Ω →
        ContMDiffOn ((modelWithCornersSelf ℝ ℝ).prod (modelWithCornersSelf ℝ (FsFltz.Geometry.Model d)))
            (modelWithCornersSelf ℝ (FsFltz.Geometry.Model d)).tangent (↑⊤) (fun p => ⟨p.2, Z p.1 p.2⟩) Ω →
          ∀ (P : M.Point → ℝ),
            ContMDiff (modelWithCornersSelf ℝ (FsFltz.Geometry.Model d)) (modelWithCornersSelf ℝ ℝ) (↑⊤) P →
              IsProperMap P →
                BddBelow (Set.range P) →
                  ∀ (D : ℝ),
                    0 ≤ D →
                      (∀ t ∈ FsFltz.Geometry.parameterInterval, ∀ (x : M.Point), |M.scalarDerivative P x (Z t x)| ≤ D) →
                        ∀ (s : ↑FsFltz.Geometry.Parameter) (x : M.Point),
                          ∃ γ,
                            γ ↑s = x ∧
                              ∀ t ∈ FsFltz.Geometry.parameterInterval,
                                HasMFDerivAt% γ t (ContinuousLinearMap.smulRight 1 (Z t (γ t)))
